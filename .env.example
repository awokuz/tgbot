# Bu faylni nusxalab, nomini ".env" qiling va qiymatlarni almashtiring.
# MUHIM: .env faylini hech kimga yubormang, tokenni hech joyda ko'rsatmang!

# BotFather bergan token
BOT_TOKEN=123456789:AAH-bu-yerga-ozingizning-tokeningizni-yozing

# Sizning Telegram ID raqamingiz (@userinfobot beradi). Faqat raqamlar.
# Bir nechta ega bo'lsa, vergul bilan yozing: 111111,222222
OWNER_IDS=123456789

# Vaqt mintaqasi (O'zbekiston = 5). Odatda o'zgartirish shart emas.
TZ_OFFSET=5
